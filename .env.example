# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/new-import-export-website?retryWrites=true&w=majority

# Auth.js / NextAuth v5
AUTH_SECRET=replace-with-a-long-random-string
# For a self-hosted production server, set this to the same confirmed HTTPS origin below.
# AUTH_URL=https://your-confirmed-domain

# Admin seed, used by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Cloudinary image uploads for admin catalogue images
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=meridian-global-trade

# Gmail SMTP notifications
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
NOTIFY_EMAIL=trade@example.com

# Use localhost for development. Before deploying, replace it with the confirmed HTTPS domain.
# Run npm run check:seo after setting the production value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
